[Unit]
Description=CONATEL WhatsApp Bot & Panel
After=network.target

[Service]
Type=simple
# Cambia 'pi' por tu usuario de Linux si es diferente (ej: ubuntu, admin)
User=pi
WorkingDirectory=/home/pi/conatel-bot
ExecStart=/usr/bin/node src/index.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production
# Límite de archivos abiertos (importante para Baileys)
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target